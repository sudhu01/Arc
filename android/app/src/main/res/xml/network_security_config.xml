<?xml version="1.0" encoding="utf-8"?>
<!--
  Production traffic goes to the relay over HTTPS (the default ngrok URL), so
  cleartext (http://) is DENIED by default. It stays permitted only for local
  development hosts: the Android emulator's host alias and localhost. To test a
  dev build against a LAN-IP server over http, add that IP as another <domain>.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
